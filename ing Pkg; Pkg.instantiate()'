[32m+[m[32m        for key in ("mass","mean","minimum","maximum","l2_error","linf_error","variance"); d[key]=Float64[]; end[m
[32m+[m[32m        for (k,t) in enumerate(c["time"])[m
[32m+[m[32m            u=c["u"][:,:,k]; exact=exact_field(c["x"],c["y"],t;cx=data.metadata["cx"],cy=data.metadata["cy"])[m
[32m+[m[32m            for (key,value) in (("mass",c["dx"]*c["dy"]*sum(u)),("mean",sum(u)/length(u)),("minimum",minimum(u)),("maximum",maximum(u)),("l2_error",sqrt(sum(abs2,u-exact)/length(u))),("linf_error",maximum(abs,u-exact)))[m
[32m+[m[32m                require(isfinite(value),"$id/$key: 非有限な診断値です"); push!(d[key],value)[m
[32m+[m[32m            end[m
