[32m+[m[32m# N02: 流束、周期左隣添字、流束差分のTODO 3か所を実装する。[m
[32m+[m[32m# 読む順: 流束 → 添字 → 1ステップ → 境界 → simulate → main。[m
[32m+[m[32mmodule N02NonlinearAdvection[m
[32m+[m[32minclude("provided_support.jl")[m
[32m+[m[32mexport burgers_flux, periodic_left_index, nonlinear_upwind_step!, apply_boundary!, simulate, main[m
[32m+[m
[32m+[m[32m"""有限なスカラーのBurgers流束。流束自体は負の値にも定義される。"""[m
[32m+[m[32mfunction burgers_flux(u::Real)[m
[32m+[m[32m    isfinite(u) || throw(ArgumentError("流束の入力を有限値にしてください"))[m
[32m+[m[32m    # TODO(N02): 保存形Burgers方程式の流束を返す。[m
[32m+[m[32m    error("未実装 N02: burgers_fluxを実装してください")[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m"""1始まりの周期配列で左隣の添字を返す。"""[m
[32m+[m[32mfunction periodic_left_index(i::Integer, n::Integer)[m
[32m+[m[32m    (i isa Bool || n isa Bool || n < 1 || !(1 <= i <= n)) &&[m
[32m+[m[32m        throw(ArgumentError("添字は1 <= i <= n、点数はn >= 1の整数です（Bool不可）"))[m
[32m+[m[32m    # TODO(N02): 先頭の左隣が末尾になるようにする。[m
[32m+[m[32m    error("未実装 N02: periodic_left_indexを実装してください")[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m"""旧配列だけを読み、流束後退差分と陽Eulerで新配列へ書く。[m
[32m+[m[32m固定境界では端点を保持し、周期境界では全点を更新する。[m
[32m+[m[32m新旧は独立した同長3点以上の浮動小数配列。境界適用は呼出し側で行う。[m
[32m+[m[32m"""[m
[32m+[m[32mfunction nonlinear_upwind_step!(u_new, u_old, dt::Real, dx::Real; boundary=:fixed)[m
[32m+[m[32m    validate_step_inputs(u_new, u_old, dt, dx, boundary)[m
[32m+[m[32m    copyto!(u_new, u_old)[m
[32m+[m[32m    indices = boundary == :periodic ? (1:length(u_old)) : (2:length(u_old)-1)[m
[32m+[m[32m    for i in indices[m
[32m+[m[32m        left = boundary == :periodic ? periodic_left_index(i, length(u_old)) : i - 1[m
[32m+[m[32m        # TODO(N02): 古い値の流束の差で更新する。u_oldは変更しない。[m
[32m+[m[32m        error("未実装 N02: nonlinear_upwind_step!の更新式を実装してください")[m
[32m+[m[32m    end[m
[32m+[m[32m    all(isfinite, u_new) || error("更新後に非有限値があります。更新式を確認してください")[m
[32m+[m[32m    return u_new[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m"""固定は左1・右隣接点コピー、周期は配列を変更しない。"""[m
[32m+[m[32mfunction apply_boundary!(u; boundary=:fixed)[m
[32m+[m[32m    validate_boundary(boundary)[m
[32m+[m[32m    length(u) >= 3 || throw(ArgumentError("境界配列には3点以上が必要です"))[m
[32m+[m[32m    if boundary == :fixed[m
[32m+[m[32m        u[1] = 1.0[m
[32m+[m[32m        u[end] = u[end-1][m
[32m+[m[32m    end[m
[32m+[m[32m    return u[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m"""独立したx,u0,uと格子・時間刻み・初期/最終診断を返す。[m
[32m+[m[32m周期公式条件はnx=80を明示する。初期最大速度から刻みを定め、最終時刻に合わせる。[m
[32m+[m[32mCFL超過でも計算を続ける。発散して非有限値になった場合は停止する。[m
[32m+[m[32m"""[m
[32m+[m[32mfunction simulate(; boundary=:fixed, nx::Integer=81, cfl::Real=0.5, t_final::Real=1.0)[m
[32m+[m[32m    validate_simulation_inputs(boundary, nx, cfl, t_final)[m
[32m+[m[32m    dx = 2.0 / (boundary == :fixed ? nx-1 : nx)[m
[32m+[m[32m    x = [j * dx for j in 0:nx-1][m
[32m+[m[32m    u0 = [0.5 <= xi <= 1.0 ? 2.0 : 1.0 for xi in x][m
[32m+[m[32m    nominal_dt = cfl * dx / maximum(abs, u0)[m
[32m+[m[32m    steps = ceil(Int, t_final / nominal_dt)[m
[32m+[m[32m    dt = t_final / steps[m
[32m+[m[32m    u_old = copy(u0)[m
[32m+[m[32m    u_new = similar(u_old)[m
[32m+[m[32m    max_cfl = maximum(abs, u_old) * dt / dx[m
[32m+[m[32m    for _ in 1:steps[m
[32m+[m[32m        nonlinear_upwind_step!(u_new, u_old, dt, dx; boundary)[m
[32m+[m[32m        apply_boundary!(u_new; boundary)[m
[32m+[m[32m        all(isfinite, u_new) || error("更新後に非有限値があります")[m
[32m+[m[32m        max_cfl = max(max_cfl, maximum(abs, u_new) * dt / dx)[m
[32m+[m[32m        u_old, u_new = u_new, u_old[m
[32m+[m[32m    end[m
[32m+[m[32m    initial_minimum, initial_maximum = extrema(u0)[m
[32m+[m[32m    low, high = extrema(u_old)[m
[32m+[m[32m    return (; x, u0, u=u_old, dx, dt, steps, max_cfl, t_final,[m
[32m+[m[32m        initial_minimum, initial_maximum, minimum=low, maximum=high,[m
[32m+[m[32m        overshoot=max(high-initial_maximum,0.0), undershoot=max(initial_minimum-low,0.0),[m
[32m+[m[32m        initial_sum=sum(u0), final_sum=sum(u_old), sum_change=sum(u_old)-sum(u0))[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32m"""固定81点・周期80点の公式計算と3出力を生成する。"""[m
[32m+[m[32mfunction main(; output_dir::AbstractString=DEFAULT_OUTPUT_DIR, cfl::Real=0.5, t_final::Real=1.0)[m
[32m+[m[32m    fixed = simulate(; boundary=:fixed, nx=81, cfl, t_final)[m
[32m+[m[32m    periodic = simulate(; boundary=:periodic, nx=80, cfl, t_final)[m
[32m+[m[32m    write_outputs(output_dir, fixed, periodic, cfl, t_final)[m
[32m+[m[32m    println("N02の出力を書き込みました: $(abspath(output_dir))")[m
[32m+[m[32m    return (; fixed, periodic)[m
[32m+[m[32mend[m
[32m+[m
[32m+[m[32mif abspath(PROGRAM_FILE) == @__FILE__[m
[32m+[m[32m    main()[m
[32m+[m[32mend[m
[32m+[m[32mend[m
