[32m+[m[32m    all(isfinite,u) || throw(ArgumentError("温度を有限値にしてください"))[m
[32m+[m[32m    positive_finite(dx,"dx")[m
[32m+[m[32m    # TODO(N03): 台形則の積分を返す。[m
