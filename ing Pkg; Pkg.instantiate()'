[32m+[m[32mconst DEFAULT_OUTPUT_DIR = joinpath(@__DIR__, "results")[m
[32m+[m
[32m+[m[32mfunction validate_boundary(boundary)[m
[32m+[m[32m    boundary in (:fixed, :periodic) || throw(ArgumentError("boundaryは:fixedまたは:periodicです"))[m
[32m+[m[32mend[m
[32m+[m[32mfunction validate_simulation_inputs(boundary, nx, cfl, t_final)[m
[32m+[m[32m    validate_boundary(boundary)[m
[32m+[m[32m    !(nx isa Bool) && nx >= 3 || throw(ArgumentError("nxは3以上の整数です（Bool不可）"))[m
[32m+[m[32m    isfinite(cfl) && cfl > 0 || throw(ArgumentError("cflは有限な正の値です"))[m
[32m+[m[32m    isfinite(t_final) && t_final > 0 || throw(ArgumentError("t_finalは有限な正の値です"))[m
[32m+[m[32mend[m
[32m+[m[32mfunction validate_step_inputs(u_new, u_old, dt, dx, boundary)[m
[32m+[m[32m    validate_boundary(boundary)[m
[32m+[m[32m    all(u -> u isa AbstractVector{<:AbstractFloat}, (u_new,u_old)) ||[m
[32m+[m[32m        throw(ArgumentError("新旧バッファは浮動小数の一次元配列です"))[m
[32m+[m[32m    Base.require_one_based_indexing(u_new,u_old)[m
[32m+[m[32m    length(u_new) == length(u_old) >= 3 || throw(ArgumentError("新旧は同長で3点以上必要です"))[m
[32m+[m[32m    Base.mightalias(u_new,u_old) && throw(ArgumentError("新旧バッファが重なっています"))[m
[32m+[m[32m    all(isfinite,u_old) || throw(ArgumentError("旧配列は有限値にしてください"))[m
[32m+[m[32m    all(v -> isfinite(v) && v > 0, (dt,dx)) || throw(ArgumentError("dtとdxは有限な正の値です"))[m
[32m+[m[32m    # CFL超過や不安定化による負値でも，同じ後退差分を続けて破綻を観察する。[m
[32m+[m[32mend[m
[32m+[m[32mfunction summary_section(result; periodic=false)[m
[32m+[m[32m    section = Dict{String,Any}("nx"=>length(result.x))[m
[32m+[m[32m    for key in (:dx,:steps,:dt,:max_cfl,:initial_minimum,:initial_maximum,:minimum,:maximum,:overshoot,:undershoot)[m
[32m+[m[32m        section[string(key)] = getproperty(result,key)[m
[32m+[m[32m    end[m
[32m+[m[32m    if periodic[m
[32m+[m[32m        for key in (:initial_sum,:final_sum,:sum_change)[m
[32m+[m[32m            section[string(key)] = getproperty(result,key)[m
[32m+[m[32m        end[m
[32m+[m[32m    end[m
[32m+[m[32m    all(isfinite,values(section)) || error("非有限な診断量は保存できません")[m
[32m+[m[32m    section[m
[32m+[m[32mend[m
[32m+[m[32mfunction solution_plot(r; periodic=false)[m
[32m+[m[32m    label = periodic ? "Periodic boundary" : "Fixed boundary"[m
[32m+[m[32m    # 周期の末尾へ表示用の点だけ追加する。診断の配列には混ぜない。[m
[32m+[m[32m    x = periodic ? vcat(r.x,2.0) : r.x[m
[32m+[m[32m    initial = periodic ? vcat(r.u0,r.u0[1]) : r.u0[m
[32m+[m[32m    final = periodic ? vcat(r.u,r.u[1]) : r.u[m
[32m+[m[32m    low = min(minimum(r.u0),minimum(r.u))[m
[32m+[m[32m    high = max(maximum(r.u0),maximum(r.u))[m
[32m+[m[32m    padding = 0.05 * (high-low)[m
[32m+[m[32m    limits = (min(0.9,low-padding),max(2.1,high+padding))[m
[32m+[m[32m    p = plot(x,initial;label="Initial",linewidth=2,xlabel="x",ylabel="u",[m
[32m+[m[32m        title="$label, t = $(r.t_final)",size=(800,500),ylims=limits)[m
[32m+[m[32m    plot!(p,x,final;label="Final",linewidth=2)[m
[32m+[m[32m    return p[m
[32m+[m[32mend[m
[32m+[m[32mfunction make_plots(output_dir, fixed, periodic)[m
[32m+[m[32m    for (r,name,isperiodic) in ((fixed,"fixed-boundary.png",false),(periodic,"periodic.png",true))[m
