[32m+[m[32m    initial_minimum,initial_maximum=extrema(u0)[m
[32m+[m[32m    low,high=initial_minimum,initial_maximum[m
[32m+[m[32m    ensure_finite((initial_heat,low,high),0,0.,effective_fo)[m
[32m+[m[32m    times=collect(range(0.,t_final;length=steps+1))[m
[32m+[m[32m    heat_history=Vector{Float64}(undef,steps+1)[m
[32m+[m[32m    heat_history[1]=initial_heat[m
[32m+[m[32m    for step in 1:steps[m
[32m+[m[32m        diffusion_step!(u_new,u_old,dt,dx,diffusivity;boundary)[m
[32m+[m[32m        ensure_finite(u_new,step,times[step+1],effective_fo)[m
[32m+[m[32m        heat=thermal_content(u_new,dx)[m
[32m+[m[32m        ensure_finite((heat,),step,times[step+1],effective_fo)[m
[32m+[m[32m        heat_history[step+1]=heat[m
[32m+[m[32m        low=min(low,minimum(u_new)); high=max(high,maximum(u_new))[m
[32m+[m[32m        u_old,u_new=u_new,u_old[m
[32m+[m[32m    end[m
[32m+[m[32m    final_heat=heat_history[end][m
[32m+[m[32m    heat_change=final_heat-initial_heat[m
[32m+[m[32m    ensure_finite((heat_change,),steps,t_final,effective_fo)[m
[32m+[m[32m    return (;x,u0,u=u_old,dx,dt,steps,fo=effective_fo,requested_fo=fo,t_final,[m
[32m+[m[32m        diffusivity,times,heat_history,initial_heat,final_heat,heat_change,[m
[32m+[m[32m        initial_minimum,initial_maximum,minimum=low,maximum=high)[m
[32m+[m[32mend[m
