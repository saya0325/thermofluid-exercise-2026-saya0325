[32m+[m[32m    positive_finite(r,"実効Fourier数")[m
[32m+[m[32m    for i in 2:length(u_old)-1[m
[32m+[m[32m        # TODO(N03): 旧配列だけから内部点の次時刻値を計算する。[m
