[32m+[m[32m"""滑らかな解析モード専用。矩形の解析解ではない。非線形の平均速度は1。"""[m
[32m+[m[32mfunction analytic_solution(x,t;model=SELECTED_MODEL,diffusivity=0.1,speed=1.0)[m
[32m+[m[32m    validate_model(model); validate_speed(model,speed)[m
[32m+[m[32m    nonnegative_finite(diffusivity,"diffusivity"); nonnegative_finite(t,"t")[m
