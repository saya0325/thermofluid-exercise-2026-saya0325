[32m+[m[32m"""両境界の標準計算と解析モードの格子収束から公式4出力を生成する。"""[m
[32m+[m[32mfunction main(;output_dir::AbstractString=DEFAULT_OUTPUT_DIR)[m
[32m+[m[32m    fixed=simulate()[m
[32m+[m[32m    insulated=simulate(;boundary=:insulated)[m
