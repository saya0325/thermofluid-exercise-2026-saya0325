[32m+[m[32m            if isnothing(v)[m
[32m+[m[32m                complete=false[m
[32m+[m[32m            else[m
[32m+[m[32m                require(v isa Float64 && isfinite(v) && v>=0,"$id/variance: 有限・非負のFloat64または未完成のnothingが必要です")[m
[32m+[m[32m                push!(d["variance"],v)[m
[32m+[m[32m            end[m
[32m+[m[32m        end[m
[32m+[m[32m        cases[id]=d[m
[32m+[m[32m    end[m
[32m+[m[32m    if !complete[m
[32m+[m[32m        for d in values(cases); delete!(d,"variance"); end[m
[32m+[m[32m    end[m
[32m+[m[32m    ids=sort(collect(keys(cases));by=id->cases[id]["nx"])[m
[32m+[m[32m    errors=[last(cases[id]["l2_error"]) for id in ids][m
[32m+[m[32m    require(all(>(0),errors),"最終誤差は正である必要があります（初期時刻で収束を評価しません）")[m
